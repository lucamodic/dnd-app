{
  "expo": {
    "name": "Dragones & Principiantes",
    "slug": "dnd-app",
    "version": "1.0.0",
    "scheme": "dndapp",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#060407",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dndapp.beginners"
    },
    "android": {
      "package": "com.dndapp.beginners",
      "adaptiveIcon": {
        "backgroundColor": "#221932"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6fe026c9-9802-42cd-a970-8f1a0ec780f1"
      }
    },
    "owner": "insomnya"
  }
}
